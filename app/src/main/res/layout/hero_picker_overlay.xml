<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EE0F0F1A"
    android:padding="16dp"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎯 Tap Your Hero"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#E94560"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/picker_stats_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reading stats…"
        android:textSize="13sp"
        android:textColor="#A0A0A0"
        android:fontFamily="monospace"
        android:layout_marginBottom="12dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridLayout
            android:id="@+id/hero_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"/>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/picker_cancel_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancel"
            android:backgroundTint="#333333"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/picker_save_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💾 Save Hero"
            android:backgroundTint="#E94560"
            android:textColor="#FFFFFF"/>
    </LinearLayout>
</LinearLayout>
