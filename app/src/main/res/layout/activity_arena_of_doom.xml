<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f0f1a"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏟️ Arena of Doom"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#e94560"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Capture heroes from the game, then build the ultimate 5-tile team"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_gravity="center_horizontal"
            android:textAlignment="center"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/roster_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Roster: 0/50"
                android:textSize="14sp"
                android:textColor="#a0a0a0" />

            <Button
                android:id="@+id/clear_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clear"
                android:textSize="12sp"
                android:backgroundTint="#333333"
                android:textColor="#ff4444"
                android:padding="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:text="No heroes captured yet.\n\nGo to a hero profile in Doomsday and tap the floating button with 'Save to Arena' mode."
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:visibility="visible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/roster_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/optimize_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎯 Optimize Team"
            android:textSize="16sp"
            android:backgroundTint="#e94560"
            android:textColor="#ffffff"
            android:padding="16dp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:id="@+id/result_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>